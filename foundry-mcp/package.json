{
  "name": "foundry-mcp",
  "version": "2026.03.0910",
  "description": "MCP server for bootstrapping Now Assist POC projects with Foundry",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "foundry-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "dev:setup": "bash scripts/dev-setup.sh",
    "test": "tsx test/validate-init.ts",
    "test:keep": "tsx test/validate-init.ts --keep",
    "test:servicenow": "tsx test/validate-servicenow.ts",
    "test:exec": "tsx test/test-exec-utils.ts",
    "test:mcp": "tsx test/mcp-integration.ts",
    "test:redact": "tsx test/validate-redact.ts",
    "test:script-api": "tsx test/validate-script-api.ts",
    "test:live": "npm run build && tsx test/live-integration.ts",
    "test:live:keybank": "npm run build && tsx test/live-integration.ts --profile keybank",
    "test:all": "npm run test && npm run test:servicenow && npm run test:redact && npm run test:exec && npm run test:mcp && npm run test:script-api",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "servicenow",
    "now-assist",
    "foundry",
    "claude-code"
  ],
  "author": "AI Foundry Team",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist"
  ]
}
